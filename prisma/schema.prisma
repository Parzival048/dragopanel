// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  avatar        String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  servers       Server[]
  payments      Payment[]
  subscriptions Subscription[]
  commandLogs   CommandLog[]
  
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// PLANS & PRICING
// ============================================

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("INR")
  memory      Int      // MB
  disk        Int      // MB
  cpu         Int      // Percentage (100 = 1 core)
  databases   Int
  backups     Int
  allocations Int
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  features    String[] // Array of feature strings
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  servers       Server[]
  subscriptions Subscription[]

  @@index([slug])
  @@index([isActive])
}

// ============================================
// SERVERS
// ============================================

model Server {
  id              String       @id @default(cuid())
  name            String
  pterodactylId   Int          @unique
  identifier      String       @unique
  uuid            String       @unique
  userId          String
  planId          String
  eggId           Int
  eggName         String?
  nodeId          Int
  allocationId    Int
  status          ServerStatus @default(PENDING)
  isSuspended     Boolean      @default(false)
  suspendedAt     DateTime?
  suspendedReason String?
  expiresAt       DateTime
  lastRenewalAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan         @relation(fields: [planId], references: [id])
  commandLogs CommandLog[]
  backups     Backup[]
  databases   Database[]

  @@index([userId])
  @@index([pterodactylId])
  @@index([identifier])
  @@index([status])
}

enum ServerStatus {
  PENDING
  INSTALLING
  RUNNING
  STOPPED
  SUSPENDED
  DELETED
}

// ============================================
// PAYMENTS & SUBSCRIPTIONS
// ============================================

model Payment {
  id              String        @id @default(cuid())
  userId          String
  orderId         String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  cashfreeOrderId String?
  cashfreePaymentId String?
  paymentMethod   String?
  paymentTime     DateTime?
  planId          String?
  serverName      String?
  metadata        Json?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?

  @@index([userId])
  @@index([orderId])
  @@index([cashfreeOrderId])
  @@index([status])
}

model Subscription {
  id          String             @id @default(cuid())
  userId      String
  planId      String
  serverId    String?
  paymentId   String             @unique
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime
  autoRenew   Boolean            @default(true)
  renewalReminder DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([serverId])
  @@index([status])
  @@index([endDate])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

// ============================================
// BACKUPS & DATABASES
// ============================================

model Backup {
  id             String   @id @default(cuid())
  serverId       String
  uuid           String   @unique
  name           String
  ignoredFiles   String?
  bytes          BigInt   @default(0)
  checksum       String?
  isSuccessful   Boolean  @default(false)
  isLocked       Boolean  @default(false)
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([uuid])
}

model Database {
  id         String   @id @default(cuid())
  serverId   String
  databaseId Int      @unique
  name       String
  username   String
  remote     String   @default("%")
  host       String
  port       Int      @default(3306)
  createdAt  DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

// ============================================
// COMMAND LOGS
// ============================================

model CommandLog {
  id         String   @id @default(cuid())
  serverId   String
  userId     String
  command    String
  executedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([userId])
  @@index([executedAt])
}

// ============================================
// EGGS (Cached from Pterodactyl)
// ============================================

model Egg {
  id          String   @id @default(cuid())
  eggId       Int      @unique
  nestId      Int
  name        String
  description String?
  dockerImage String
  startup     String?
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([nestId])
  @@index([isActive])
}
