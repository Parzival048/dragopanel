# ===========================================
# DRAGOHOST ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.local and fill in the values

# Database (Supabase PostgreSQL)
# Replace [PROJECT_REF] with your Supabase project ID and [PASSWORD] with your database password
# Note: URL-encode special characters in password (@ = %40)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# NextAuth.js
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Pterodactyl Panel
PTERODACTYL_URL="https://your-pterodactyl-panel.example.com"
PTERODACTYL_API_KEY="your-pterodactyl-application-api-key"
PTERODACTYL_CLIENT_KEY="your-pterodactyl-client-api-key"
# Admin user ID in Pterodactyl (required for console access)
# Find this in Pterodactyl Admin -> Users -> click on your admin user -> see ID in URL
PTERODACTYL_ADMIN_USER_ID="1"

# Wings WebSocket (Node URL)
WINGS_URL="https://your-wings-node.example.com:8080"

# Cashfree Payment Gateway (use sandbox for testing)
CASHFREE_APP_ID="your-cashfree-app-id"
CASHFREE_SECRET_KEY="your-cashfree-secret-key"
CASHFREE_ENV="sandbox"
CASHFREE_API_URL="https://sandbox.cashfree.com/pg"

# Modrinth API (Public, no key required)
MODRINTH_API_URL="https://api.modrinth.com/v2"

# App Configuration
NEXT_PUBLIC_APP_NAME="Dragohost"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/your-server"
